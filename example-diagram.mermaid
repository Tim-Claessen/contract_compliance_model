erDiagram

  %% ═══════════════════════════════════
  %% ref schema (persists across runs)
  %% ═══════════════════════════════════

  %% ── Execution ──
  RUN ||--o{ SOURCE_SNAPSHOT : "loads into active"
  RUN ||--o{ RESULT_SUMMARY : "produces in active"
  RUN ||--o{ VALIDATION_OVERRIDE : "run-level override"

  %% ── Test definitions & mappings ──
  TEST_DEFINITION ||--o{ RESULT_SUMMARY : "generates"
  TEST_DEFINITION ||--o{ TEST_RISK_MAP : "maps to risks"
  TEST_DEFINITION ||--o{ TEST_PROCESS_MAP : "maps to processes"
  TEST_DEFINITION ||--o{ TEST_SOURCE_MAP : "uses sources"

  TEST_RISK_MAP }o--|| RISK : "links to"
  TEST_PROCESS_MAP }o--|| PROCESS : "links to"
  TEST_SOURCE_MAP }o--|| SOURCE_TABLE_REGISTRY : "references"

  TEST_DEFINITION }o--o| PROCESS : "primary process"
  SOURCE_TABLE_REGISTRY }o--|| PROCESS : "belongs to"

  %% ── Source data ──
  SOURCE_SNAPSHOT }o--|| SOURCE_TABLE_REGISTRY : "instance of"

  %% ── Results & classification ──
  RESULT_SUMMARY }o--o| FINDING_CATEGORY : "classified as"
  RESULT_SUMMARY ||--o{ RESULT_DETAIL : "drill-through"

  %% ── Validation ──
  VALIDATION }o--|| TEST_DEFINITION : "for test"
  VALIDATION }o--|| FINDING_CATEGORY : "for category"
  VALIDATION_OVERRIDE }o--|| VALIDATION : "overrides"

  %% ═══════════════════════════════════
  %% Entity definitions
  %% ═══════════════════════════════════

  %% ── ref schema ──

  RUN {
    int run_id PK
    date run_date
    string run_period
    string status "in_progress | validated | complete"
  }

  TEST_DEFINITION {
    int test_id PK
    string test_name
    string test_description
    string test_logic_ref "SP or script name"
    int primary_process_id FK
    string owner
  }

  TEST_RISK_MAP {
    int test_id FK
    int risk_id FK
  }
  TEST_PROCESS_MAP {
    int test_id FK
    int process_id FK
  }
  TEST_SOURCE_MAP {
    int test_id FK
    int source_table_id FK
  }

  SOURCE_TABLE_REGISTRY {
    int source_table_id PK
    string table_name "src_{process}_{entity}"
    int process_id FK
  }

  PROCESS {
    int process_id PK
    string name
    int parent_process_id FK "self-ref 3-level hierarchy"
    int level "1 to 3"
  }

  RISK {
    int risk_id PK
    string name
    int parent_risk_id FK "self-ref 3-level hierarchy"
    int level "1 to 3"
  }

  FINDING_CATEGORY {
    int category_id PK
    string category_name
    string description
  }

  VALIDATION {
    int validation_id PK
    int test_id FK
    int category_id FK
    string disposition
    string explanation
    date effective_from
  }

  VALIDATION_OVERRIDE {
    int override_id PK
    int validation_id FK
    int run_id FK
    string disposition
    string explanation
  }

  %% ── active / archive schemas ──

  SOURCE_SNAPSHOT {
    int snapshot_id PK
    int run_id FK
    int source_table_id FK
    string record_key "business key of source row"
  }

  RESULT_SUMMARY {
    int result_id PK
    int run_id FK
    int test_id FK
    int category_id FK "nullable until classified"
    string status
    string explanation "pre-populated from validation"
  }

  RESULT_DETAIL {
    string _note "one table per test"
    string _naming "result_detail_{process}_{test}"
    int detail_id PK
    int result_id FK
    string source_columns "test-specific columns"
  }